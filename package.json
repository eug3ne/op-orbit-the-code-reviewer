{
  "name": "code-reviewer-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:server\"",
